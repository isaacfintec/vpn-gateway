{
  "compilerOptions": {
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "target": "ES2018",
    "module": "CommonJS",
    "outDir": "./dist",
    "strict": false,
    "types": ["node", "jest", "fastify"],
    "baseUrl": "./src",
    "sourceMap": true,
    "paths": {
      "*": ["node_modules/*"],
    }
  },
  "include": [
    "src/**/*.ts",
    "src/domain/types/fastify.d.ts",
    "tests/**/*.spec.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
